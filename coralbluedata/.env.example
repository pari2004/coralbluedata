# Copy to .env.local and fill in. NEVER commit real secrets.

# Core
NODE_ENV=development
APP_URL=http://localhost:3000

# Database (Neon Postgres). Get the connection string from the Neon console.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_DIALECT=postgres

# Auth / sessions — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_HOURS=12

# Email (optional). If unset, enquiry notifications are skipped & logged — never faked.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Coral Blue Data <no-reply@coralbluedata.com>"
# MAIL_TO=you@coralbluedata.com

# Media storage
MEDIA_DRIVER=disk
MEDIA_DIR=./data/media
